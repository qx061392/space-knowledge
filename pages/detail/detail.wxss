.page { min-height: 100vh; }
.content-scroll { position: relative; }
.container { padding: 24rpx 32rpx 0; }

/* Hero */
.detail-hero { text-align: center; padding: 40rpx 20rpx 32rpx; position: relative; overflow: hidden; margin-bottom: 24rpx; }
.detail-hero-bg { position: absolute; top: -40rpx; left: 50%; transform: translateX(-50%); width: 400rpx; height: 400rpx; pointer-events: none; }
.detail-icon { width: 120rpx; height: 120rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid; margin: 0 auto 20rpx; position: relative; z-index: 1; }
.detail-icon-emoji { font-size: 60rpx; }
.detail-cat { font-size: 22rpx; display: block; margin-bottom: 12rpx; position: relative; z-index: 1; }
.detail-title { font-size: 42rpx; font-weight: 800; color: #FFF; display: block; position: relative; z-index: 1; line-height: 1.3; }
.detail-subtitle { font-size: 28rpx; color: #8B92B0; margin-top: 8rpx; display: block; position: relative; z-index: 1; }
.detail-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin-top: 20rpx; position: relative; z-index: 1; }
.detail-year { font-size: 22rpx; color: #6B7280; }
.detail-tag { font-size: 22rpx; color: #4B5568; }

/* Sections */
.detail-section { margin-bottom: 36rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #FFF; margin-bottom: 20rpx; display: flex; align-items: center; }
.section-title::before { content: ''; width: 8rpx; height: 28rpx; background: linear-gradient(180deg, #00D4FF, #7B61FF); border-radius: 4rpx; margin-right: 16rpx; }

/* Key Data */
.keydata-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.keydata-item { width: calc(50% - 8rpx); background: rgba(26,31,58,0.7); border: 1rpx solid rgba(0,212,255,0.08); border-radius: 16rpx; padding: 20rpx 24rpx; }
.keydata-value { font-size: 30rpx; font-weight: 700; color: #00D4FF; display: block; }
.keydata-label { font-size: 22rpx; color: #8B92B0; margin-top: 4rpx; display: block; }

/* Summary */
.detail-summary-box { background: rgba(0,212,255,0.06); border-left: 6rpx solid #00D4FF; border-radius: 12rpx; padding: 24rpx; }
.detail-summary { font-size: 28rpx; color: #C8CCD8; line-height: 1.7; }

/* Content */
.detail-content { }
.detail-paragraph { font-size: 30rpx; color: #D0D4E0; line-height: 1.9; margin-bottom: 28rpx; display: block; text-align: justify; }

/* Tags */
.detail-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.detail-tag-lg { font-size: 24rpx; color: #00D4FF; background: rgba(0,212,255,0.08); border: 1rpx solid rgba(0,212,255,0.15); padding: 8rpx 20rpx; border-radius: 24rpx; }

/* Action Bar */
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 16rpx 32rpx; background: rgba(11,16,38,0.95); border-top: 1rpx solid rgba(0,212,255,0.1); z-index: 100; }
.action-fav { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12rpx; border-radius: 16rpx; background: rgba(26,31,58,0.8); border: 1rpx solid rgba(255,255,255,0.05); }
.action-fav:active { transform: scale(0.95); }
.action-fav-active { border-color: rgba(255,181,71,0.3); background: rgba(255,181,71,0.08); }
.action-fav-icon { font-size: 36rpx; color: #6B7280; }
.action-fav-active .action-fav-icon { color: #FFB547; }
.action-fav-text { font-size: 22rpx; color: #6B7280; margin-top: 2rpx; }
.action-fav-active .action-fav-text { color: #FFB547; }
.action-share { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12rpx; border-radius: 16rpx; background: rgba(26,31,58,0.8); border: 1rpx solid rgba(255,255,255,0.05); margin: 0; line-height: normal; }
.action-share::after { border: none; }
.action-share:active { transform: scale(0.95); }
.action-share-icon { font-size: 36rpx; color: #00D4FF; }
.action-share-text { font-size: 22rpx; color: #00D4FF; margin-top: 2rpx; }

.safe-bottom { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }

/* Reading Progress Bar */
.read-progress-bar { position: fixed; top: 0; left: 0; right: 0; height: 4rpx; background: rgba(255,255,255,0.06); z-index: 200; }
.read-progress-fill { height: 100%; background: linear-gradient(90deg, #00D4FF, #7B61FF); transition: width 0.1s; }

/* Font Toggle */
.section-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-title-row .section-title { margin-bottom: 0; }
.font-toggle { display: flex; align-items: center; gap: 8rpx; background: rgba(0,212,255,0.1); border: 1rpx solid rgba(0,212,255,0.2); border-radius: 20rpx; padding: 6rpx 16rpx; }
.font-toggle:active { transform: scale(0.95); }
.font-toggle-icon { font-size: 22rpx; color: #00D4FF; font-weight: 700; }
.font-toggle-label { font-size: 20rpx; color: #00D4FF; }

/* Update Badge */
.detail-update-badge { font-size: 20rpx; color: #2ECC71; background: rgba(46,204,113,0.12); padding: 2rpx 12rpx; border-radius: 16rpx; }

/* Animations */
@keyframes fadeInUp { from { opacity:0; transform:translateY(20rpx); } to { opacity:1; transform:translateY(0); } }
.fade-in-up { animation: fadeInUp 0.4s ease-out both; }
