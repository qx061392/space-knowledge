.page { min-height: 100vh; }
.container { padding: 24rpx 32rpx; }
.fav-tab-bar { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.fav-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 20rpx; background: rgba(26,31,58,0.5); border: 1rpx solid rgba(255,255,255,0.05); border-radius: 20rpx; }
.tab-active { background: rgba(0,212,255,0.1); border-color: rgba(0,212,255,0.3); }
.fav-tab-text { font-size: 30rpx; font-weight: 600; color: #8B92B0; }
.tab-active .fav-tab-text { color: #00D4FF; }
.fav-tab-count { font-size: 22rpx; color: #6B7280; background: rgba(255,255,255,0.08); padding: 2rpx 12rpx; border-radius: 16rpx; }
.tab-active .fav-tab-count { color: #00D4FF; background: rgba(0,212,255,0.15); }

.fav-header { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.fav-clear-btn { font-size: 24rpx; color: #6B7280; padding: 4rpx 8rpx; }

.fav-item { display: flex; align-items: center; background: linear-gradient(135deg, rgba(26,31,58,0.9) 0%, rgba(16,20,42,0.9) 100%); border: 1rpx solid rgba(255,255,255,0.05); border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; position: relative; overflow: hidden; }
.fav-item:active { transform: scale(0.98); }
.fav-item-glow { position: absolute; top: 0; right: 0; width: 200rpx; height: 100%; pointer-events: none; }
.fav-item-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid; margin-right: 20rpx; flex-shrink: 0; position: relative; z-index: 1; }
.fav-item-emoji { font-size: 36rpx; }
.fav-item-info { flex: 1; min-width: 0; position: relative; z-index: 1; }
.fav-item-title { font-size: 30rpx; font-weight: 600; color: #FFF; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fav-item-sub { font-size: 24rpx; color: #8B92B0; margin-top: 4rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fav-item-cat { font-size: 20rpx; margin-top: 8rpx; display: block; }
.fav-item-action { padding: 16rpx; position: relative; z-index: 1; }
.fav-item-star { font-size: 36rpx; color: #FFB547; }
.fav-item-action:active { transform: scale(1.2); }
.fav-item-arrow { font-size: 40rpx; color: #4B5568; position: relative; z-index: 1; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 140rpx 0; }
.empty-icon { font-size: 96rpx; opacity: 0.4; margin-bottom: 24rpx; }
.empty-text { color: #6B7280; font-size: 30rpx; }
.empty-hint { color: #4B5568; font-size: 24rpx; margin-top: 8rpx; }
