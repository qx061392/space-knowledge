.page { min-height: 100vh; }
.container { padding: 24rpx 32rpx; }

/* Intro */
.quiz-intro { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.quiz-intro-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.quiz-intro-title { font-size: 48rpx; font-weight: 800; color: #FFF; }
.quiz-intro-desc { font-size: 28rpx; color: #8B92B0; margin-top: 12rpx; text-align: center; }
.quiz-best { display: flex; align-items: center; margin-top: 48rpx; background: rgba(26,31,58,0.7); border: 1rpx solid rgba(0,212,255,0.1); border-radius: 20rpx; padding: 28rpx 48rpx; }
.quiz-best-item { text-align: center; }
.quiz-best-num { font-size: 56rpx; font-weight: 800; color: #00D4FF; display: block; }
.quiz-best-label { font-size: 22rpx; color: #8B92B0; }
.quiz-best-divider { width: 1rpx; height: 60rpx; background: rgba(255,255,255,0.08); margin: 0 48rpx; }
.quiz-start-btn { margin-top: 48rpx; background: linear-gradient(90deg, #00D4FF, #0099E0); border-radius: 48rpx; padding: 24rpx 80rpx; box-shadow: 0 8rpx 32rpx rgba(0,212,255,0.2); }
.quiz-start-btn:active { transform: scale(0.95); opacity: 0.9; }
.quiz-start-text { font-size: 34rpx; font-weight: 700; color: #0B1026; }
.quiz-tip { font-size: 22rpx; color: #6B7280; margin-top: 24rpx; }

/* Progress */
.quiz-progress-bar { width: 100%; height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx; overflow: hidden; margin-bottom: 20rpx; }
.quiz-progress-fill { height: 100%; background: linear-gradient(90deg, #00D4FF, #7B61FF); border-radius: 4rpx; transition: width 0.3s ease; }
.quiz-counter { display: flex; align-items: center; margin-bottom: 28rpx; }
.quiz-counter-cur { font-size: 40rpx; font-weight: 800; color: #00D4FF; }
.quiz-counter-total { font-size: 32rpx; color: #6B7280; }
.quiz-score-display { margin-left: auto; font-size: 26rpx; color: #FFB547; font-weight: 600; }

/* Question Card */
.quiz-card { background: linear-gradient(135deg, rgba(26,31,58,0.95) 0%, rgba(16,20,42,0.95) 100%); border: 1rpx solid rgba(0,212,255,0.12); border-radius: 24rpx; padding: 36rpx; }
.quiz-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.quiz-cat-tag { font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 500; }
.quiz-difficulty { font-size: 20rpx; padding: 6rpx 16rpx; background: rgba(255,255,255,0.06); border-radius: 20rpx; font-weight: 500; }
.quiz-question { font-size: 34rpx; font-weight: 700; color: #FFF; line-height: 1.6; display: block; margin-bottom: 28rpx; }

/* Options */
.quiz-options { margin-bottom: 24rpx; }
.quiz-option { display: flex; align-items: center; background: rgba(26,31,58,0.6); border: 2rpx solid rgba(255,255,255,0.06); border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.quiz-option:active { border-color: rgba(0,212,255,0.3); }
.opt-letter { width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; color: #8B92B0; margin-right: 20rpx; flex-shrink: 0; }
.opt-text { flex: 1; font-size: 28rpx; color: #D0D4E0; }
.opt-icon { font-size: 32rpx; color: #2ECC71; }
.opt-icon-wrong { color: #E94B3C; }
.opt-correct { border-color: rgba(46,204,113,0.4) !important; background: rgba(46,204,113,0.08) !important; }
.opt-correct .opt-letter { background: rgba(46,204,113,0.2); color: #2ECC71; }
.opt-correct .opt-text { color: #2ECC71; }
.opt-wrong { border-color: rgba(233,75,60,0.4) !important; background: rgba(233,75,60,0.08) !important; }
.opt-wrong .opt-letter { background: rgba(233,75,60,0.2); color: #E94B3C; }
.opt-wrong .opt-text { color: #E94B3C; }

/* Explanation */
.quiz-explanation { background: rgba(0,212,255,0.06); border-left: 6rpx solid #00D4FF; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.quiz-exp-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.quiz-exp-icon { font-size: 28rpx; margin-right: 12rpx; }
.quiz-exp-title { font-size: 28rpx; font-weight: 700; color: #FFF; }
.quiz-exp-text { font-size: 26rpx; color: #A0A8C0; line-height: 1.7; }

/* Next Button */
.quiz-next-btn { text-align: center; padding: 20rpx; background: rgba(26,31,58,0.5); border: 2rpx solid rgba(255,255,255,0.06); border-radius: 40rpx; color: #6B7280; font-size: 28rpx; font-weight: 600; }
.btn-active { background: linear-gradient(90deg, #00D4FF, #0099E0); border-color: transparent; color: #0B1026; }
.btn-active:active { transform: scale(0.95); }

/* Animations */
@keyframes fadeInUp { from { opacity:0; transform:translateY(20rpx); } to { opacity:1; transform:translateY(0); } }
.fade-in-up { animation: fadeInUp 0.4s ease-out both; }
