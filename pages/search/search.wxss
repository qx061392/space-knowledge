.page { min-height: 100vh; }
.container { padding: 24rpx 32rpx; }
.search-input-bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 32rpx; }
.search-input-inner { flex: 1; display: flex; align-items: center; background: rgba(26,31,58,0.7); border: 1rpx solid rgba(0,212,255,0.15); border-radius: 40rpx; padding: 16rpx 28rpx; }
.search-input-inner:focus-within { border-color: rgba(0,212,255,0.4); }
.search-icon { font-size: 28rpx; margin-right: 12rpx; opacity: 0.6; }
.search-input { flex: 1; color: #E8EAF1; font-size: 28rpx; }
.ph { color: #6B7280; }
.search-clear { font-size: 28rpx; color: #6B7280; padding: 4rpx 8rpx; }
.search-btn { font-size: 28rpx; color: #00D4FF; font-weight: 600; padding: 8rpx 12rpx; flex-shrink: 0; }

.search-section { margin-bottom: 36rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #FFF; margin-bottom: 20rpx; }
.clear-btn { font-size: 24rpx; color: #6B7280; font-weight: 400; }

.tag-cloud { display: flex; flex-wrap: wrap; gap: 16rpx; }
.hot-tag { font-size: 26rpx; color: #C8CCD8; background: rgba(26,31,58,0.6); border: 1rpx solid rgba(0,212,255,0.1); padding: 10rpx 24rpx; border-radius: 24rpx; }
.hot-tag:active { background: rgba(0,212,255,0.1); }

.history-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.history-tag { font-size: 24rpx; color: #8B92B0; background: rgba(26,31,58,0.4); padding: 8rpx 20rpx; border-radius: 24rpx; }

.results-count { font-size: 24rpx; color: #6B7280; margin-bottom: 20rpx; }

.result-item { background: linear-gradient(135deg, rgba(26,31,58,0.9) 0%, rgba(16,20,42,0.9) 100%); border: 1rpx solid rgba(0,212,255,0.08); border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; }
.result-item:active { transform: scale(0.98); }
.result-top { display: flex; align-items: flex-start; }
.result-icon { font-size: 40rpx; margin-right: 20rpx; flex-shrink: 0; }
.result-info { flex: 1; min-width: 0; }
.result-title-row { display: flex; flex-wrap: wrap; align-items: baseline; }
.result-title-row text { font-size: 30rpx; font-weight: 700; color: #FFF; }
.result-summary-row { margin-top: 8rpx; display: flex; flex-wrap: wrap; }
.result-summary { font-size: 24rpx; color: #8B92B0; line-height: 1.5; }
.highlight { color: #00D4FF !important; font-weight: 700; background: rgba(0,212,255,0.08); border-radius: 4rpx; padding: 0 4rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 96rpx; opacity: 0.4; margin-bottom: 24rpx; }
.empty-text { color: #6B7280; font-size: 28rpx; }
.empty-hint { color: #4B5568; font-size: 24rpx; margin-top: 8rpx; }
