.page { min-height: 100vh; }
.container { padding: 24rpx 32rpx; }
.page-header { margin-bottom: 32rpx; }
.page-title { font-size: 42rpx; font-weight: 800; color: #FFF; display: block; }
.page-desc { font-size: 26rpx; color: #8B92B0; margin-top: 8rpx; display: block; }
.cat-block {
  background: linear-gradient(135deg, rgba(26,31,58,0.92) 0%, rgba(16,20,42,0.92) 100%);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.4s ease-out both;
}
.cat-block:active { transform: scale(0.98); }
.cat-block-glow { position: absolute; top: 0; right: 0; width: 300rpx; height: 300rpx; pointer-events: none; }
.cat-block-header { display: flex; align-items: center; position: relative; z-index: 1; }
.cat-block-icon { width: 88rpx; height: 88rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid; flex-shrink: 0; margin-right: 24rpx; }
.cat-block-emoji { font-size: 44rpx; }
.cat-block-info { flex: 1; min-width: 0; }
.cat-block-name { font-size: 32rpx; font-weight: 700; color: #FFF; display: block; }
.cat-block-count { font-size: 22rpx; color: #8B92B0; margin-top: 4rpx; display: block; }
.cat-block-arrow { font-size: 36rpx; font-weight: 700; }
.cat-block-preview { display: flex; align-items: center; padding: 20rpx 0; border-top: 1rpx solid rgba(255,255,255,0.05); margin-top: 20rpx; position: relative; z-index: 1; }
.cat-block-preview:active { background: rgba(255,255,255,0.03); }
.preview-emoji { font-size: 32rpx; margin-right: 16rpx; }
.preview-text { flex: 1; min-width: 0; }
.preview-title { font-size: 26rpx; color: #E8EAF1; display: block; }
.preview-sub { font-size: 22rpx; color: #6B7280; margin-top: 2rpx; display: block; }
.ellipsis-1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@keyframes fadeInUp { from { opacity:0; transform:translateY(20rpx); } to { opacity:1; transform:translateY(0); } }
.fade-in-up { animation: fadeInUp 0.4s ease-out both; }
