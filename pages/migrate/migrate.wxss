.page { min-height: 100vh; }
.migrate-card { background: linear-gradient(135deg, rgba(26,31,58,0.95), rgba(16,20,42,0.95)); border: 1rpx solid rgba(0,212,255,0.15); border-radius: 24rpx; padding: 48rpx 36rpx; text-align: center; }
.migrate-icon { font-size: 96rpx; }
.migrate-title { font-size: 36rpx; font-weight: 700; color: #FFF; display: block; margin-top: 16rpx; }
.migrate-desc { font-size: 26rpx; color: #8B92B0; display: block; margin-top: 12rpx; line-height: 1.6; }
.migrate-status { margin-top: 32rpx; }
.status-msg { font-size: 30rpx; color: #00D4FF; display: block; }
.status-detail { font-size: 24rpx; color: #8B92B0; display: block; margin-top: 4rpx; }
.progress-bar { width: 100%; height: 8rpx; background: rgba(255,255,255,0.08); border-radius: 4rpx; margin: 20rpx 0; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #00D4FF, #7B61FF); border-radius: 4rpx; transition: width 0.3s; }
.progress-num { font-size: 24rpx; color: #00D4FF; }
.migrate-btn { margin-top: 32rpx; background: linear-gradient(90deg, #00D4FF, #0099E0); border-radius: 40rpx; padding: 24rpx 60rpx; display: inline-block; }
.migrate-btn:active { transform: scale(0.95); }
.migrate-btn text { color: #0B1026; font-size: 30rpx; font-weight: 700; }
.migrate-tip { margin-top: 24rpx; }
.migrate-tip text { display: block; font-size: 24rpx; color: #2ECC71; line-height: 1.8; }
.migrate-tip-box { margin-top: 40rpx; background: rgba(0,0,0,0.15); border-radius: 16rpx; padding: 24rpx; }
.tip-title { font-size: 26rpx; color: #E8EAF1; display: block; font-weight: 600; margin-bottom: 8rpx; }
.tip-line { font-size: 24rpx; color: #6B7280; display: block; line-height: 1.8; }
