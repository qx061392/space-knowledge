.page {
  min-height: 100vh;
  position: relative;
}

.container {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx;
}

/* Hero */
.hero {
  background: linear-gradient(135deg, rgba(0,212,255,0.08) 0%, rgba(123,97,255,0.08) 100%);
  border: 1rpx solid rgba(0,212,255,0.15);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(0,212,255,0.12), transparent 70%);
  border-radius: 50%;
}

.hero-badge {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.hero-badge-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #8B92B0;
  margin-top: 4rpx;
  display: block;
}

.hero-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 36rpx;
  position: relative;
  z-index: 1;
}

.hero-stat {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  display: block;
  background: linear-gradient(180deg, #00D4FF, #7B61FF);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* Search Bar */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(26,31,58,0.7);
  border: 1rpx solid rgba(0,212,255,0.15);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
}

.search-input-wrap:active {
  border-color: rgba(0,212,255,0.4);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-placeholder {
  color: #6B7280;
  font-size: 28rpx;
}

/* Section */
.section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00D4FF, #7B61FF);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: #00D4FF;
}

.daily-badge {
  font-size: 22rpx;
  color: #00D4FF;
  background: rgba(0,212,255,0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* Daily Card */
.daily-card {
  background: linear-gradient(135deg, rgba(26,31,58,0.95) 0%, rgba(16,20,42,0.95) 100%);
  border: 1rpx solid rgba(0,212,255,0.15);
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.daily-card:active {
  transform: scale(0.98);
}

.daily-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
}

.daily-top {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.daily-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.daily-icon-emoji {
  font-size: 44rpx;
}

.daily-info {
  flex: 1;
  min-width: 0;
}

.daily-cat {
  font-size: 22rpx;
  display: block;
  margin-bottom: 6rpx;
}

.daily-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.daily-subtitle {
  font-size: 24rpx;
  color: #8B92B0;
  margin-top: 4rpx;
  display: block;
}

.daily-summary {
  font-size: 28rpx;
  color: #A0A8C0;
  line-height: 1.7;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.daily-footer {
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.daily-readmore {
  font-size: 26rpx;
  color: #00D4FF;
  font-weight: 600;
}

/* Category Grid */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.category-item {
  width: calc(33.33% - 16rpx);
  background: linear-gradient(135deg, rgba(26,31,58,0.9) 0%, rgba(16,20,42,0.9) 100%);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.category-item:active {
  transform: scale(0.95);
  border-color: rgba(0,212,255,0.3);
}

.cat-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid;
  margin-bottom: 16rpx;
}

.cat-icon-emoji {
  font-size: 40rpx;
}

.cat-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #E8EAF1;
  margin-bottom: 4rpx;
}

.cat-count {
  font-size: 20rpx;
  color: #6B7280;
}

/* Quiz Banner */
.quiz-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(0,212,255,0.12) 0%, rgba(123,97,255,0.12) 100%);
  border: 1rpx solid rgba(0,212,255,0.2);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  position: relative;
  overflow: hidden;
}

.quiz-banner:active {
  transform: scale(0.98);
}

.quiz-banner-glow {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.05), transparent 70%);
  border-radius: 50%;
}

.quiz-banner-left {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.quiz-banner-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.quiz-banner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.quiz-banner-desc {
  font-size: 22rpx;
  color: #8B92B0;
  margin-top: 4rpx;
  display: block;
}

.quiz-banner-arrow {
  font-size: 36rpx;
  color: #00D4FF;
  position: relative;
  z-index: 1;
}

/* History */
.history-list {
  background: rgba(26,31,58,0.5);
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(255,255,255,0.03);
}

.history-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-title {
  font-size: 28rpx;
  color: #E8EAF1;
  display: block;
}

.history-time {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
  display: block;
}

.history-arrow {
  font-size: 36rpx;
  color: #4B5568;
}

/* Footer */
.footer-text {
  text-align: center;
  font-size: 22rpx;
  color: #4B5568;
  padding: 16rpx 0;
}

/* Animations */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in-up {
  animation: fadeInUp 0.4s ease-out both;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* Loading */
.loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
.loading-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.loading-text { font-size: 28rpx; color: #6B7280; }

/* Migrate entry */
.migrate-entry { text-align: center; padding: 12rpx 0; }
.migrate-entry text { font-size: 22rpx; color: #4B5568; }
