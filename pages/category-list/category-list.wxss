.page { min-height: 100vh; }
.container { padding: 24rpx 32rpx; }
.cat-header { display: flex; align-items: center; margin-bottom: 28rpx; }
.cat-header-icon { width: 96rpx; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid; margin-right: 24rpx; }
.cat-header-emoji { font-size: 48rpx; }
.cat-header-info { flex: 1; }
.cat-header-name { font-size: 36rpx; font-weight: 800; color: #FFF; display: block; }
.cat-header-count { font-size: 24rpx; color: #8B92B0; margin-top: 4rpx; display: block; }
.sort-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.sort-item { font-size: 24rpx; color: #6B7280; padding: 8rpx 24rpx; background: rgba(26,31,58,0.5); border-radius: 20rpx; border: 1rpx solid rgba(255,255,255,0.05); }
.sort-active { color: #00D4FF; border-color: rgba(0,212,255,0.3); background: rgba(0,212,255,0.08); }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 96rpx; opacity: 0.4; margin-bottom: 24rpx; }
.empty-text { color: #6B7280; font-size: 28rpx; }
.fade-in-up { animation: fadeInUp 0.4s ease-out both; }
@keyframes fadeInUp { from { opacity:0; transform:translateY(20rpx); } to { opacity:1; transform:translateY(0); } }
