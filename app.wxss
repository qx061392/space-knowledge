/* ===== 航天知识库 全局样式 ===== */

page {
  background-color: #0B1026;
  color: #E8EAF1;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, scroll-view, swiper {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

/* 深空背景渐变 */
.space-bg {
  background: linear-gradient(180deg, #0B1026 0%, #131838 50%, #0B1026 100%);
}

/* 星空粒子背景 */
.starfield {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.starfield::before,
.starfield::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  box-shadow:
    40rpx 80rpx 0 0 rgba(255,255,255,0.5),
    120rpx 200rpx 0 0 rgba(255,255,255,0.4),
    200rpx 60rpx 0 0 rgba(0,212,255,0.5),
    300rpx 300rpx 0 0 rgba(255,255,255,0.3),
    380rpx 120rpx 0 0 rgba(255,107,53,0.4),
    460rpx 400rpx 0 0 rgba(255,255,255,0.5),
    540rpx 200rpx 0 0 rgba(255,255,255,0.3),
    620rpx 500rpx 0 0 rgba(0,212,255,0.3),
    700rpx 80rpx 0 0 rgba(255,255,255,0.4),
    80rpx 480rpx 0 0 rgba(255,255,255,0.3),
    160rpx 600rpx 0 0 rgba(255,255,255,0.5),
    240rpx 340rpx 0 0 rgba(0,212,255,0.4),
    340rpx 660rpx 0 0 rgba(255,255,255,0.3),
    440rpx 180rpx 0 0 rgba(255,255,255,0.4),
    560rpx 540rpx 0 0 rgba(255,107,53,0.3),
    640rpx 260rpx 0 0 rgba(255,255,255,0.5),
    720rpx 580rpx 0 0 rgba(255,255,255,0.3);
}

.starfield::after {
  width: 3rpx;
  height: 3rpx;
  box-shadow:
    60rpx 140rpx 0 0 rgba(255,255,255,0.4),
    180rpx 260rpx 0 0 rgba(0,212,255,0.3),
    280rpx 100rpx 0 0 rgba(255,255,255,0.3),
    400rpx 380rpx 0 0 rgba(255,255,255,0.5),
    500rpx 160rpx 0 0 rgba(255,107,53,0.4),
    580rpx 440rpx 0 0 rgba(255,255,255,0.4),
    660rpx 60rpx 0 0 rgba(255,255,255,0.3),
    20rpx 360rpx 0 0 rgba(255,255,255,0.4),
    100rpx 540rpx 0 0 rgba(0,212,255,0.5),
    220rpx 420rpx 0 0 rgba(255,255,255,0.3),
    320rpx 580rpx 0 0 rgba(255,255,255,0.4),
    420rpx 80rpx 0 0 rgba(255,255,255,0.5),
    520rpx 320rpx 0 0 rgba(255,255,255,0.3),
    620rpx 620rpx 0 0 rgba(0,212,255,0.4),
    740rpx 320rpx 0 0 rgba(255,255,255,0.4);
}

/* 卡片 */
.card {
  background: linear-gradient(135deg, rgba(26,31,58,0.9) 0%, rgba(16,20,42,0.9) 100%);
  border: 1rpx solid rgba(0,212,255,0.12);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.card:active {
  transform: scale(0.98);
  transition: transform 0.15s;
}

/* 标题样式 */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #00D4FF, #7B61FF);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 分类标签 */
.category-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.cat-spacecraft { background: rgba(74,144,226,0.2); color: #5BA0F5; }
.cat-history { background: rgba(233,75,60,0.2); color: #FF6B5E; }
.cat-solar-system { background: rgba(245,166,35,0.2); color: #FFB84D; }
.cat-astronauts { background: rgba(123,97,255,0.2); color: #9B85FF; }
.cat-basics { background: rgba(46,204,113,0.2); color: #5BE08A; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(90deg, #00D4FF 0%, #0099E0 100%);
  color: #0B1026;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-ghost {
  background: transparent;
  color: #00D4FF;
  font-size: 28rpx;
  border: 2rpx solid rgba(0,212,255,0.4);
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  text-align: center;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(90deg, #00D4FF, #7B61FF);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-state .empty-text {
  color: #6B7280;
  font-size: 28rpx;
}

/* 渐入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.4s ease-out;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 超出省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 自定义 tabBar 页面底部留白 */
.tab-bottom-space {
  height: 140rpx;
}
