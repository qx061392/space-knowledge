.kc-card {
  background: linear-gradient(135deg, rgba(26,31,58,0.92) 0%, rgba(16,20,42,0.92) 100%);
  border: 1rpx solid rgba(0,212,255,0.1);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}

.kc-card:active {
  transform: scale(0.97);
  border-color: rgba(0,212,255,0.3);
}

.kc-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  pointer-events: none;
  z-index: 0;
}

.kc-top {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.kc-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.kc-icon-emoji {
  font-size: 40rpx;
}

.kc-info {
  flex: 1;
  min-width: 0;
}

.kc-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.kc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kc-year {
  font-size: 22rpx;
  color: #6B7280;
  flex-shrink: 0;
  font-weight: 500;
}

.kc-subtitle {
  font-size: 24rpx;
  color: #8B92B0;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kc-bottom {
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.kc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.kc-cat-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.kc-tag {
  font-size: 20rpx;
  color: #6B7280;
  padding: 4rpx 0;
}

.kc-summary {
  font-size: 26rpx;
  color: #A0A8C0;
  line-height: 1.6;
}

.kc-compact {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.kc-compact .kc-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.kc-compact .kc-icon-emoji {
  font-size: 32rpx;
}

.kc-compact .kc-title {
  font-size: 28rpx;
}

.kc-compact .kc-subtitle {
  font-size: 22rpx;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
