<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'tab-active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <text class="tab-icon">{{item.icon}}</text>
      <view class="tab-dot" wx:if="{{selected === index}}"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
