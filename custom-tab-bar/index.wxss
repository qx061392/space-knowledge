.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #0F1530;
  border-top: 1rpx solid rgba(0, 212, 255, 0.1);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 8rpx;
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  font-size: 40rpx;
  opacity: 0.5;
  transition: all 0.2s ease;
}

.tab-dot {
  position: absolute;
  bottom: -8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #00D4FF;
  box-shadow: 0 0 8rpx rgba(0, 212, 255, 0.5);
}

.tab-text {
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 4rpx;
  transition: color 0.2s ease;
}

.tab-active .tab-icon {
  opacity: 1;
  transform: scale(1.1);
}

.tab-active .tab-text {
  color: #00D4FF;
  font-weight: 600;
}
